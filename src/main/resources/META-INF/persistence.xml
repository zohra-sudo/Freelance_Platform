<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="FreelancePU" transaction-type="JTA">

        <!-- Le DataSource qu'on a créé dans WildFly -->
        <jta-data-source>java:/jdbc/FreelanceDS</jta-data-source>
        <class>com.example.freelanceplatform.entities.User</class>
        <class>com.example.freelanceplatform.entities.Poste</class>
        <class>com.example.freelanceplatform.entities.Message</class>
        <class>com.example.freelanceplatform.entities.Discussion</class>
        <class>com.example.freelanceplatform.entities.Candidature</class>
        <class>com.example.freelanceplatform.entities.Project</class>
        <class>com.example.freelanceplatform.entities.Application</class>
        <properties>
            <!-- Crée les tables automatiquement -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- Affiche les requêtes SQL dans la console -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>